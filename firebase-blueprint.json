{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific data, settings and personal information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "profileImage": { "type": "string" },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "AppConfig": {
      "title": "Application Configuration",
      "description": "Global settings for the application.",
      "type": "object",
      "properties": {
        "facebookPage": { "type": "string" },
        "facebookGroup": { "type": "string" },
        "version": { "type": "string" },
        "announcement": { "type": "string" }
      }
    },
    "Admin": {
      "title": "Admin User",
      "description": "A user with administrative privileges.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["email", "uid"]
    },
    "NotificationContent": {
      "title": "Notification Content",
      "description": "Daily facts or motivational quotes.",
      "type": "object",
      "properties": {
        "text_bn": { "type": "string" },
        "text_en": { "type": "string" },
        "type": { "type": "string", "enum": ["fact", "motivation"] }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and data."
    },
    "config/global": {
      "schema": "AppConfig",
      "description": "Global app configuration."
    },
    "admins/{uid}": {
      "schema": "Admin",
      "description": "List of authorized administrators."
    },
    "notifications_content/{id}": {
      "schema": "NotificationContent",
      "description": "Dynamic content for daily notifications."
    }
  }
}
